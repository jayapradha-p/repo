{"Name":"Add Comment To Incident","Description":"Add comment to incident in Microsoft 365 Defender.","Script":"from ScriptResult import EXECUTION_STATE_COMPLETED, EXECUTION_STATE_FAILED\nfrom SiemplifyAction import SiemplifyAction\nfrom SiemplifyUtils import output_handler\n\nfrom TIPCommon.extraction import extract_configuration_param, extract_action_param\n\nfrom constants import (\n    INTEGRATION_NAME,\n    ADD_COMMENT_TO_INCIDENT_SCRIPT_NAME,\n    INTEGRATION_DISPLAY_NAME,\n    LOGIN_API_ROOT_DEFAULT,\n    GRAPH_API_ROOT_DEFAULT,\n)\nfrom Microsoft365DefenderManager import (\n    Microsoft365DefenderManager,\n    NotFoundItemException,\n)\n\n\n@output_handler\ndef main():\n    siemplify = SiemplifyAction()\n    siemplify.script_name = ADD_COMMENT_TO_INCIDENT_SCRIPT_NAME\n    siemplify.LOGGER.info(\"----------------- Main - Param Init -----------------\")\n\n    login_api_root = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Login API Root\",\n        is_mandatory=True,\n        default_value=LOGIN_API_ROOT_DEFAULT,\n        print_value=True,\n    )\n    graph_api_root = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Graph API Root\",\n        is_mandatory=True,\n        default_value=GRAPH_API_ROOT_DEFAULT,\n        print_value=True,\n    )\n    api_root = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"API Root\",\n        is_mandatory=True,\n        print_value=True,\n    )\n    tenant_id = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Tenant ID\",\n        is_mandatory=True,\n        print_value=True,\n    )\n    client_id = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Client ID\",\n        is_mandatory=True,\n        print_value=True,\n    )\n    client_secret = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Client Secret\",\n        is_mandatory=True,\n        remove_whitespaces=False,\n    )\n    verify_ssl = extract_configuration_param(\n        siemplify,\n        provider_name=INTEGRATION_NAME,\n        param_name=\"Verify SSL\",\n        input_type=bool,\n        is_mandatory=True,\n        print_value=True,\n    )\n\n    # Action parameters\n    incident_id = extract_action_param(\n        siemplify, param_name=\"Incident ID\", is_mandatory=True, print_value=True\n    )\n    comment = extract_action_param(siemplify, param_name=\"Comment\", is_mandatory=True)\n\n    siemplify.LOGGER.info(\"----------------- Main - Started -----------------\")\n\n    try:\n        try:\n            incident_id = int(incident_id)\n        except ValueError:\n            raise NotFoundItemException(\n                f'incident \"{incident_id}\" wasn\\'t found in Microsoft 365 Defender'\n            )\n\n        manager = Microsoft365DefenderManager(\n            api_root=api_root,\n            tenant_id=tenant_id,\n            client_id=client_id,\n            client_secret=client_secret,\n            verify_ssl=verify_ssl,\n            microsoft_graph_url=graph_api_root,\n            siemplify=siemplify,\n            login_api_root=login_api_root,\n        )\n        manager.add_comment_to_incident(incident_id=incident_id, comment=comment)\n        result = True\n        status = EXECUTION_STATE_COMPLETED\n        output_message = f\"Successfully added comment to incident {incident_id} in {INTEGRATION_DISPLAY_NAME}.\"\n\n    except Exception as e:\n        siemplify.LOGGER.error(\n            f\"General error performing action {ADD_COMMENT_TO_INCIDENT_SCRIPT_NAME}\"\n        )\n        siemplify.LOGGER.exception(e)\n        result = False\n        status = EXECUTION_STATE_FAILED\n        output_message = (\n            f'Error executing action \"Add Comment To Incident\". Reason: {e}'\n        )\n\n    siemplify.LOGGER.info(\"----------------- Main - Finished -----------------\")\n    siemplify.LOGGER.info(f\"Status: {status}\")\n    siemplify.LOGGER.info(f\"Result: {result}\")\n    siemplify.LOGGER.info(f\"Output Message: {output_message}\")\n\n    siemplify.end(output_message, result, status)\n\n\nif __name__ == \"__main__\":\n    main()\n","IntegrationIdentifier":"Microsoft365DefenderBeta","ScriptResultName":"is_success","DynamicResultsMetadata":[],"Creator":"admin","IsEnabled":true,"IsCustom":true,"AiGenerated":false,"IsSystem":false,"Version":0.0,"TimeoutSeconds":600,"IsAsync":null,"AsyncPollingIntervalInSeconds":300,"TotalIntervalTimeoutForAsyncInSeconds":3600,"Parameters":[{"CustomActionId":0,"IsMandatory":true,"DefaultValue":"","Description":"Specify the id of the incident that needs to be updated.","Name":"Incident ID","Value":"","Type":0,"OptionalValues":null,"OptionalValuesJson":null},{"CustomActionId":0,"IsMandatory":true,"DefaultValue":"","Description":"Specify the comment that needs to be added to the incident.","Name":"Comment","Value":"","Type":0,"OptionalValues":null,"OptionalValuesJson":null}],"DefaultResultValue":null,"PythonVersion":"None","ActionType":1,"SimulationData":{"Entities":null},"SimulationDataJson":null,"AICategories":[],"OutcomeCategories":[],"AIDescription":"### General Description\nAdds a comment to a specific incident in Microsoft 365 Defender. This action is used to document findings, provide updates, or add context to an existing incident within the Microsoft 365 Defender portal directly from Google SecOps.\n\n### Flow Description\n1. **Initialization**: The action initializes the Microsoft 365 Defender manager using the provided integration configuration.\n2. **Parameter Validation**: It extracts and validates the `Incident ID` and `Comment` parameters. The `Incident ID` is converted to an integer format required by the API.\n3. **API Interaction**: The action sends a POST request to the Microsoft Graph API endpoint (`/v1.0/security/incidents/{incident_id}/comments`) containing the comment text.\n4. **Error Handling**: If the incident is not found (404 error), it raises a specific `NotFoundItemException`. Other API errors are caught and reported as execution failures.\n5. **Completion**: Upon a successful API response, the action returns a success status and an informative output message.\n\n### Additional Notes\nNone.","AiShortDescription":"Adds a comment to a specific incident in Microsoft 365 Defender.","ParametersDescription":"| Parameter | Type | Mandatory | Description |\n| --- | --- | --- | --- |\n| Incident ID | String | Yes | Specify the id of the incident that needs to be updated. |\n| Comment | String | Yes | Specify the comment that needs to be added to the incident. |","ImpactAnalysisActionsMetadata":null,"EntityTypes":[]}